# Both are optional — the demo runs end to end without them (typed answers +
# deterministic understanding). Server-only: never prefix with NEXT_PUBLIC_.

# The live onboarding call: AssemblyAI Voice Agent API (natural voice, streaming
# speech-to-text, turn detection) + Universal-3.5 Pro for the fallback path.
# https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# Optional: Persona's voice. US: alba (default), eve, jane, jean, mary, george, michael · UK: anna, vera, charles, paul
PERSONA_VOICE=

# Transcript understanding via DeepSeek V4.1 Flash (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
